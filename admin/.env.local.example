GEMINI_API_KEY=your_key_here
GEMINI_ANALYSIS_MODEL=gemini-2.5-flash
# server.js(온라인 코칭 서버)가 온라인 세션을 저장할 때 쓰는 내부 인증 토큰.
# server.js의 .env에도 같은 값을 INTERNAL_API_TOKEN으로 넣어야 한다.
INTERNAL_API_TOKEN=change_me_to_a_random_value
# 관리자 페이지 전체를 보호하는 HTTP Basic Auth 계정. 민감한 연구 데이터가 있으니 필수.
ADMIN_USERNAME=change_me
ADMIN_PASSWORD=change_me_to_a_strong_password
